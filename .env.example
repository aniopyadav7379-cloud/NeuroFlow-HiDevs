# Copy to .env and fill in real values. Never commit the real .env.

# ── App ──────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# ── Postgres ─────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=neuroflow
POSTGRES_USER=neuroflow
POSTGRES_PASSWORD=change_me
POSTGRES_POOL_MIN_SIZE=2
POSTGRES_POOL_MAX_SIZE=10

# ── Redis ────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me

# ── MLflow ───────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://mlflow:5000

# ── Tracing ──────────────────────────────────────────────────────────────
OTEL_SERVICE_NAME=neuroflow-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_TRACES_ENABLED=true

# ── Embeddings ───────────────────────────────────────────────────────────
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ── RLS roles (see infra/init/002_rls.sql) ─────────────────────────────
DB_APP_ROLE=neuroflow_app
DB_ADMIN_ROLE=neuroflow_admin

# ── LLM providers (backend/providers/) ─────────────────────────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
