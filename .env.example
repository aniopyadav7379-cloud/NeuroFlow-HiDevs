# ── Database ─────────────────────────────────────────────────────────
POSTGRES_PASSWORD=         # Required: strong random password
POSTGRES_URL=              # Required (prod/cloud): full connection string
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=neuroflow
POSTGRES_USER=neuroflow

# ── Redis ────────────────────────────────────────────────────────────
REDIS_PASSWORD=            # Required: strong random password
REDIS_URL=                 # Required (prod/cloud): full connection string
REDIS_HOST=redis
REDIS_PORT=6379

# ── LLM Providers ────────────────────────────────────────────────────
OPENAI_API_KEY=            # Required
ANTHROPIC_API_KEY=         # Optional: enables the Anthropic provider

# ── MLflow ───────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=       # Required: e.g. http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=neuroflow-finetuning

# ── Security ─────────────────────────────────────────────────────────
JWT_SECRET_KEY=            # Required: openssl rand -hex 32
AUTH_CLIENTS_JSON=         # Required in prod: JSON registry of client_id -> {secret, scopes}
PLUGIN_SECRETS_KEY=        # Reserved, not yet consumed by any code in this repo

# ── Telemetry ────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=  # Optional (default: http://jaeger:4317)
SENTRY_DSN=                    # Optional, not yet wired into backend/main.py

# ── App ──────────────────────────────────────────────────────────────
ENVIRONMENT=               # Required: development | staging | production
LOG_LEVEL=INFO              # Optional: DEBUG | INFO | WARNING

# ── Ingestion / fine-tuning storage ──────────────────────────────────
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=100
TRAINING_DATA_DIR=/app/training_data
